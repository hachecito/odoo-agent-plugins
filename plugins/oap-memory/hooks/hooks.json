{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/mem-guard.js"], "timeout": 30 }
        ]
      }
    ],
    "PostToolUseFailure": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/memory-hook.js"], "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/memory-hook.js"], "timeout": 10 } ] }
    ]
  }
}
