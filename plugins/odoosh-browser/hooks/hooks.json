{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|mcp__github__.*|mcp__composio__.*|mcp__.*claude-in-chrome__.*|mcp__.*([Cc]hrome[-_]devtools|[Pp]laywright|[Pp]uppeteer|browsermcp|browser[-_]use|browserbase).*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard.js"],
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/memory-hook.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/memory-hook.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
