{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|mcp__github__.*|mcp__composio__.*|mcp__.*claude-in-chrome__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard.js"],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
